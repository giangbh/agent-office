{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 1 -X POST -H 'Content-Type: application/json' -H \"X-Agent-Office-Token: $AGENT_OFFICE_TOKEN\" --data-binary @- 'http://localhost:4317/event?source=codex' >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 1 -X POST -H 'Content-Type: application/json' -H \"X-Agent-Office-Token: $AGENT_OFFICE_TOKEN\" --data-binary @- 'http://localhost:4317/event?source=codex' >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 1 -X POST -H 'Content-Type: application/json' -H \"X-Agent-Office-Token: $AGENT_OFFICE_TOKEN\" --data-binary @- 'http://localhost:4317/event?source=codex' >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 1 -X POST -H 'Content-Type: application/json' -H \"X-Agent-Office-Token: $AGENT_OFFICE_TOKEN\" --data-binary @- 'http://localhost:4317/event?source=codex' >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 1 -X POST -H 'Content-Type: application/json' -H \"X-Agent-Office-Token: $AGENT_OFFICE_TOKEN\" --data-binary @- 'http://localhost:4317/event?source=codex' >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}